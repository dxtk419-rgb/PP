/* Elemental Duel: offline webpage cache (requires HTTPS hosting). */
const CACHE = 'elemental-duel-solo-v1';
self.addEventListener('install', event => {
  event.waitUntil(caches.open(CACHE).then(cache => cache.add('./index.html')).then(() => self.skipWaiting()));
});
self.addEventListener('activate', event => {
  event.waitUntil(Promise.all([
    caches.keys().then(keys => Promise.all(keys.filter(key => key !== CACHE).map(key => caches.delete(key)))),
    self.clients.claim()
  ]));
});
self.addEventListener('fetch', event => {
  if(event.request.method !== 'GET' || new URL(event.request.url).origin !== self.location.origin)return;
  event.respondWith((async () => {
    try {
      const response=await fetch(event.request);
      if(response.ok && (event.request.mode === 'navigate' || event.request.url.endsWith('/index.html'))){
        const cache=await caches.open(CACHE);cache.put('./index.html',response.clone());
      }
      return response;
    }catch(_){
      return await caches.match(event.request) || await caches.match('./index.html') || Response.error();
    }
  })());
});
